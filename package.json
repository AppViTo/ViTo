{
  "name": "vito-contract-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling del contrato ejecutable de ViTo: lint OpenAPI/AsyncAPI y mock REST (Prism). No es un paquete de aplicación; solo existe para que el circuito contrato → mock → test funcione.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint:api": "spectral lint docs/api/openapi.yaml",
    "lint:async": "node scripts/validate-asyncapi.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "contract": "npm run lint:api && npm run validate:fixtures && npm run lint:async",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "test:smoke": "node --test scripts/smoke-e2e.test.mjs",
    "mock:api": "prism mock docs/api/openapi.yaml --dynamic --port 4010 --host 0.0.0.0",
    "mock:ws": "node scripts/mock-ws.mjs",
    "test:mock-ws": "node --test scripts/mock-ws.test.mjs"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/spectral-cli": "6.17.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "ws": "8.18.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "6.29.1",
    "ip-address": "10.7.4",
    "lodash": "4.18.1",
    "jsonpath-plus": "10.4.0",
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1",
    "uuid": "11.1.1"
  }
}
