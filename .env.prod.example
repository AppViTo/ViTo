# ViTo — variables de PRODUCCIÓN (docker-compose.prod.yml, ADR-011)
#
# El archivo completo es el secreto DOTENV_PRODUCTION de los GitHub Environments
# (production, production-hotfix, production-preflight), con una copia en el gestor de
# contraseñas (ADR-013). cd.yml lo escribe en /opt/vito/.env (0600) en cada despliegue
# (feature 001, research R15): para cambiar un valor se edita el secreto y se redespliega.
# Nunca en el repositorio. Guía: docs/runbooks/aprovisionamiento.md, paso 4.
#
# Un valor vacío hace fallar `docker compose up`: no hay valores por defecto para secretos.
# Secretos aleatorios: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ── Despliegue ────────────────────────────────────────────────
# Las versiones de las imágenes NO van aquí: llegan por el manifiesto versions.env de cada
# release (una TAG_<SERVICIO> por servicio, más CFG_CADDY y CFG_SRS), que genera
# infrastructure/deploy/remote/deploy.sh (research R1, R4).
# Dominio raíz: Caddy sirve api.<DOMAIN> y live.<DOMAIN> (registros DNS A → IP del VPS)
DOMAIN=
# Correo para avisos de Let's Encrypt (el correo de equipo, ADR-013)
ACME_EMAIL=
# Origen de la web (Cloudflare Pages), separado por comas si hay varios
CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Mosaico (T-I21, excepción A3) ─────────────────────────────
# true abre en el gateway POST /api/v1/media/upload y las escrituras del mosaico de la Ola 3
# (post, grid/initialize, like). Cambiar a true SOLO con T-B25 y T-B26 desplegadas
# (re-codificación y moderación de imágenes). Vacía o ausente = false (cerrada).
MOSAIC_UPLOADS_ENABLED=false

# ── MongoDB ───────────────────────────────────────────────────
MONGO_ROOT_USERNAME=vito_admin
MONGO_ROOT_PASSWORD=

# ── Redis / Kafka ─────────────────────────────────────────────
REDIS_PASSWORD=
KAFKA_PASSWORD=
# Identificador del clúster KRaft, se genera una vez y no cambia:
#   docker run --rm apache/kafka:3.8.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# ── Seguridad ─────────────────────────────────────────────────
# Mínimo 32 bytes; idéntico en todos los servicios
JWT_SECRET=
# Distinto de JWT_SECRET
QR_SECRET=

# ── Cloudflare R2 (T-I10) ─────────────────────────────────────
# Token "Object Read & Write" limitado a vito-media y vito-backups (T-I06)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vito-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Dominio propio conectado al bucket vito-media en R2
S3_PUBLIC_URL=https://media.example.com

# ── Backup de Mongo (T-I09) ───────────────────────────────────
BACKUP_BUCKET=vito-backups
BACKUP_AT=03:00
BACKUP_RETENTION_DAYS=14

# ── Grafana Cloud (T-I13) ─────────────────────────────────────
# Endpoints y usuarios de la instancia gratuita; el token se comparte para
# métricas, logs y trazas. Se pegan desde Grafana Cloud → Connections.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_OTLP_USER=
GRAFANA_CLOUD_TOKEN=

# ── Streaming ─────────────────────────────────────────────────
# IP pública del VPS: la anuncia SRS a los clientes WebRTC
SRS_CANDIDATE=
