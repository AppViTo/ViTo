# ViTo — variables de entorno
# Copiar a .env (ignorado por git) y rellenar. infrastructure/scripts/setup.sh lo hace
# automáticamente y genera secretos aleatorios.
#
# Los servicios FALLAN AL ARRANCAR si falta un secreto: no hay valores por defecto.
#
#   Solo infraestructura:        docker compose up -d
#   Stack completo en Docker:    docker compose --profile app up -d --build
#                                (API en http://localhost:8080 a través del api-gateway)
#
# Spring Boot no lee .env: si ejecutas un servicio fuera de Docker, exporta las variables
# en el shell/IDE antes de `./mvnw spring-boot:run` (docker compose y pydantic-settings sí lo leen).

# ── MongoDB ───────────────────────────────────────────────────
MONGO_ROOT_USERNAME=vito_admin
MONGO_ROOT_PASSWORD=
# Cada servicio Spring fija su propia base de datos; la URI solo aporta host y credenciales.
MONGODB_URI=mongodb://vito_admin:<MONGO_ROOT_PASSWORD>@localhost:27017/?authSource=admin
MONGODB_DB_NAME=vito_db

# ── Seguridad ─────────────────────────────────────────────────
# HMAC-SHA256: mínimo 32 bytes. Generar con: openssl rand -base64 48
# Debe ser IDÉNTICO en todos los servicios (el gateway valida lo que firma auth-service).
JWT_SECRET=
# Firma de códigos QR (checkin-service, event-service). Distinto de JWT_SECRET.
QR_SECRET=

# ── Object storage (API S3: SeaweedFS local / Cloudflare R2 en producción) ──
# Lo leen media-service y transcode-service. Los valores de abajo son los de local.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vito-media
S3_ACCESS_KEY=vito_s3
S3_SECRET_KEY=
# SeaweedFS exige path-style (<endpoint>/<bucket>/<key>); R2 acepta ambos.
S3_PATH_STYLE=true
# Crear el bucket al arrancar si no existe. En R2 el token no tiene ese permiso: false.
S3_CREATE_BUCKET=true
# Base de las URLs públicas de los archivos. Vacío = <S3_ENDPOINT>/<S3_BUCKET>.
S3_PUBLIC_URL=
#
# Producción (Cloudflare R2, ADR-011). Token de API "Object Read & Write" limitado a los
# buckets vito-media y vito-backups (T-I06):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=vito-media
#   S3_ACCESS_KEY=<Access Key ID del token R2>
#   S3_SECRET_KEY=<Secret Access Key del token R2>
#   S3_PATH_STYLE=true
#   S3_CREATE_BUCKET=false
#   S3_PUBLIC_URL=https://media.<dominio>   (dominio propio conectado al bucket en R2)

# ── Backup de Mongo (infrastructure/backup, T-I09) ────────────
# Usa las mismas credenciales S3 de arriba. En producción: bucket vito-backups de R2.
BACKUP_BUCKET=vito-backups
# Hora UTC del backup diario (HH:MM) y días que se conservan
BACKUP_AT=03:00
BACKUP_RETENTION_DAYS=14

# ── Herramientas de desarrollo (docker-compose.override.yml) ──
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=

# ── Redis / Kafka ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Streaming ─────────────────────────────────────────────────
SRS_API_URL=http://localhost:1985
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# ── App ───────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8080
STREAM_BASE_URL=rtmp://localhost:1935
LOG_LEVEL=DEBUG
