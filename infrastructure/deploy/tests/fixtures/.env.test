# Valores FICTICIOS para validar docker-compose.prod.yml en CI (Deploy Scripts). No son
# secretos: mismas claves que .env.prod.example, sin IMAGE_TAG (las versiones van en
# versions.env).
DOMAIN=example.test
ACME_EMAIL=ops@example.test
CORS_ALLOWED_ORIGINS=https://app.example.test
MOSAIC_UPLOADS_ENABLED=false
MONGO_ROOT_USERNAME=vito_admin
MONGO_ROOT_PASSWORD=fixture-not-a-secret
REDIS_PASSWORD=fixture-not-a-secret
KAFKA_PASSWORD=fixture-not-a-secret
KAFKA_CLUSTER_ID=fixture-cluster-id
JWT_SECRET=fixture-not-a-secret-fixture-not-a-secret
QR_SECRET=fixture-not-a-secret-qr
S3_ENDPOINT=https://r2.example.test
S3_REGION=auto
S3_BUCKET=vito-media
S3_ACCESS_KEY=fixture-not-a-secret
S3_SECRET_KEY=fixture-not-a-secret
S3_PUBLIC_URL=https://media.example.test
BACKUP_BUCKET=vito-backups
BACKUP_AT=03:00
BACKUP_RETENTION_DAYS=14
SRS_CANDIDATE=192.0.2.10
