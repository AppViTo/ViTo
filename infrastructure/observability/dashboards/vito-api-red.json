{
  "uid": "vito-api-red",
  "title": "ViTo · API RED",
  "tags": [
    "vito",
    "api",
    "red",
    "t-i13"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"vito\"}, service)",
          "refId": "service"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "uri",
        "label": "URI gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{job=\"vito\",service=\"api-gateway\"}, uri)",
          "refId": "uri"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios arriba",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{job=\"vito\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peticiones/min por servicio",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"vito\",service=~\"$service\"}[5m])) * 60",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "% 5xx",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (service) (rate(http_server_requests_seconds_count{job=\"vito\",service=~\"$service\",status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"vito\",service=~\"$service\"}[5m])), 1e-9)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p95 por URI (gateway)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"vito\",service=\"api-gateway\",uri=~\"$uri\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p99 por URI (gateway)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"vito\",service=\"api-gateway\",uri=~\"$uri\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memoria JVM heap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (jvm_memory_used_bytes{job=\"vito\",service=~\"$service\",area=\"heap\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU de proceso",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (process_cpu_usage{job=\"vito\",service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "429 por ruta (enlaces de invitación)",
      "description": "T062 (Ola 1): peticiones cortadas por el límite de tasa del gateway, por ruta. invite-link-preview es la vista previa pública (10/min por IP); invite-links, unirse por enlace (por usuario). Un pico sostenido en la vista previa sugiere que alguien prueba tokens.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{job=\"vito\",service=\"api-gateway\",httpStatusCode=\"429\",routeId=~\"invite-link.*\"}[5m])) * 60",
          "legendFormat": "{{routeId}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "429 de la búsqueda de usuarios",
      "description": "T057 (Ola 2a): búsquedas cortadas por el límite de users-search (1/s por usuario, ráfaga de 10). Un pico sostenido de pocos usuarios sugiere que alguien intenta recorrer el directorio.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{job=\"vito\",service=\"api-gateway\",httpStatusCode=\"429\",routeId=\"users-search\"}[5m])) * 60",
          "legendFormat": "{{routeId}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "social → auth: llamadas/min por resultado",
      "description": "T057 (Ola 2a): getUsersByIds desde social-service. status CLIENT_ERROR es timeout o conexión rechazada: social responde 503 con Retry-After (FR-012a).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (rate(http_client_requests_seconds_count{job=\"vito\",service=\"social-service\",client_name=\"auth-service\"}[5m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "social → auth: latencia media y máxima",
      "description": "T057 (Ola 2a): sin buckets de histograma, media (sum/count) y máximo de la ventana. La meta del perfil y las listas es p95 < 300 ms extremo a extremo.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_client_requests_seconds_sum{job=\"vito\",service=\"social-service\",client_name=\"auth-service\"}[5m])) / clamp_min(sum(rate(http_client_requests_seconds_count{job=\"vito\",service=\"social-service\",client_name=\"auth-service\"}[5m])), 1e-9)",
          "legendFormat": "media",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(http_client_requests_seconds_max{job=\"vito\",service=\"social-service\",client_name=\"auth-service\"})",
          "legendFormat": "máximo",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    }
  ]
}
