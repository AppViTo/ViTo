# Borde de producción (ADR-011): TLS automático con Let's Encrypt.
# DOMAIN y ACME_EMAIL llegan por entorno desde docker-compose.prod.yml.
# Validar: docker run --rm -e DOMAIN=x.com -e ACME_EMAIL=a@x.com -v ./Caddyfile:/etc/caddy/Caddyfile caddy:2.8.4-alpine caddy validate --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
}

# Cabeceras de seguridad de api. y live. (T-I18, T051 A4). Quitar Server implica defer:
# se aplica después de reverse_proxy, así que también borra el Server de SRS y del gateway.
# includeSubDomains cubre solo los subdominios de cada host (p. ej. *.api.), no el dominio raíz.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# API REST y WebSocket (/ws/**). reverse_proxy reenvía el Upgrade de WebSocket sin
# configuración extra; flush_interval -1 para que los frames no se queden en búfer.
api.{$DOMAIN} {
	import security_headers
	encode zstd gzip

	# Uptime externo (T037, T-I13): solo la readiness del gateway, nada más del actuator
	handle /healthz {
		rewrite * /actuator/health/readiness
		reverse_proxy api-gateway:9080
	}

	# El actuator del gateway está en el puerto de gestión 9080 (T-B14); por si acaso
	@actuator path /actuator /actuator/*
	respond @actuator 404

	reverse_proxy api-gateway:8080 {
		flush_interval -1
	}
}

# Streaming: lista blanca. Solo señalización WebRTC (WHIP/WHEP) y archivos de reproducción
# HLS/HTTP-FLV. El servidor HTTP de SRS también responde su API de gestión (/api/v1/...)
# y la consola: nada de eso se expone.
live.{$DOMAIN} {
	import security_headers

	handle /rtc/* {
		reverse_proxy srs:1985
	}

	@playback path *.m3u8 *.ts *.flv
	handle @playback {
		reverse_proxy srs:8080 {
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
